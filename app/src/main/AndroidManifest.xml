<?xml version="1.0" encoding="utf-8"?>
<!-- Budge keeps its ledger on-device: no account, no server, no sync. The single
     network use is the user-initiated update check, which is a read-only GET to the
     releases address configured in UpdateConfig, and nothing at all while that
     address is still the placeholder. No ledger data is ever sent. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required for the update check only; see the note above. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- No android:roundIcon: the round variant shipped by the project template was a
         byte-for-byte copy of the square one, so it only doubled the icon payload. A
         launcher that wants a round icon now draws this one. -->
    <application
        android:name=".BudgeApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Budge">
        <!-- Single-Activity app; the Compose NavGraph renders all screens. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Budge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
