<?xml version="1.0" encoding="utf-8"?>
<!-- Budge keeps its ledger on-device: no account, no server, no sync, and the app
     itself never uploads anything. Its single network use is the user-initiated update
     check, a read-only GET to the releases address configured in UpdateConfig, and the
     download of a release's APK when the user asks for it inside the app. Nothing is sent
     either time — no ledger data, no identifier — and nothing at all happens while that
     address is still the placeholder.

     allowBackup is on, which is what lets *Android's* backup — the user's own Google
     account, or a device-to-device transfer — carry the database and preferences along
     with the rest of the app's data. The two rule files below say exactly what may be
     included; adding an <exclude domain="database" path="." /> there keeps the ledger out
     of it. That is the system's copy of the user's own file, not a server this app syncs
     to. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required for the update check only; see the note above. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Required to hand a downloaded update to the system installer. Since Android 8 an
         app that installs a package must hold this, and the user must also allow this app
         to install unknown apps — the platform takes that decision out of the app's hands,
         and the installer shows its own confirmation on top. Nothing is installed without
         the SHA-256 the release publishes being checked first. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- No android:roundIcon: the round variant shipped by the project template was a
         byte-for-byte copy of the square one, so it only doubled the icon payload. A
         launcher that wants a round icon now draws this one. -->
    <application
        android:name=".BudgeApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Budge">
        <!-- Single-Activity app; the Compose NavGraph renders all screens. -->
        <!-- Hands the installer a content URI for one downloaded file. Not exported, and
             the grant is per-intent: nothing else can ask this provider for anything. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Budge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
